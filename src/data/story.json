    {
      "id": "chapter_02",
      "title": "Debrief",
      "description": "The warehouse gave them nothing. That's what makes it dangerous.",
      "beats": [

        {
          "id": "chapter_02_bridge",
          "label": "Chapter bridge",
          "context": "phone", "app": "sms",
          "directives": [
            { "type": "narrator_note", "note": "The warehouse gave them nothing. That's what makes it dangerous. Now the question isn't what happened. It's why it happened at all." },
            { "type": "system_message", "body": "Group Chat: TEMP-3 active" },
            {
              "type": "display_trust_state",
              "entries": [
                { "character": "char_murna", "state": "High" },
                { "character": "char_pitch", "state": "Increased" },
                { "character": "char_kelvin", "state": "Unstable" }
              ]
            },
            { "type": "pause", "duration_ms": 2000, "label": "Silence. Longer than it should be." }
          ],
          "on_complete": "beat_s3_001"
        },

        {
          "id": "beat_s3_001",
          "label": "Murna breaks the silence",
          "context": "phone", "app": "sms",
          "directives": [
            { "type": "send_text", "from": "char_murna", "thread_id": "thread_temp3", "body": "so..." },
